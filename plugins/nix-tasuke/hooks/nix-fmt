#!/usr/bin/env nix
#!nix shell nixpkgs#bash nixpkgs#git nixpkgs#findutils --command bash
set -euo pipefail

# nix fmtが実行可能なプロジェクトでのみフォーマットを実行します。
# 条件を満たさない場合は即座に正常終了します。

# CLAUDE_PROJECT_DIRが設定されていなければ異常終了します。
if [[ -z "${CLAUDE_PROJECT_DIR:-}" ]]; then
  echo "Error: CLAUDE_PROJECT_DIR is not set" >&2
  exit 1
fi

# プロジェクトのルートディレクトリに移動します。
cd "$CLAUDE_PROJECT_DIR"

# flake.nixが読み込めなければnix fmtができるNixプロジェクトではないと判断します。
if [[ ! -r "flake.nix" ]]; then
  exit 0
fi

# gitリポジトリでなければflakeが動作しないため何もしません。
if ! git rev-parse --is-inside-work-tree &>/dev/null; then
  exit 0
fi

# nixはトラッキングしていないファイルを取り扱わないので、
# 未追跡ファイルの存在だけをGitに登録します。
# git add --allは削除もステージしてしまうため、未追跡ファイルのみを対象にします。
git ls-files --others --exclude-standard | xargs -r git add --intent-to-add --

# nix fmtを実行します。
# 既にチェック済みのファイルはキャッシュされてチェックされないので、
# 連続実行してもパフォーマンスは悪くありません。
# フォーマットは自動適用され、
# リンターのエラーがあればそのままClaude Codeに伝わります。
nix fmt
