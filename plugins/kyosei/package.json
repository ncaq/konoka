{
  "name": "konoka-kyosei",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "fix": "run-p fix:*",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier --write .",
    "lint": "run-p lint:*",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:tsc": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "git-url-parse": "^16.1.0",
    "octokit": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.5",
    "@eslint/js": "10.0.1",
    "@types/git-url-parse": "16.0.2",
    "@types/node": "20.19.39",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-n": "17.24.0",
    "jiti": "2.6.1",
    "npm-run-all2": "8.0.4",
    "prettier": "3.8.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.2",
    "vitest": "4.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
